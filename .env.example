# ========== SASES 环境配置示例 ==========
# 复制此文件为 .env 并填写实际值
# 注意：.env 文件已被 .gitignore 排除，请勿提交到 Git

# ========== DeepSeek API（必填） ==========
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-flash

# ========== DashScope Embedding（混合模式，可选） ==========
# 用于知识库语义相似度判断，未配置时降级为本地模型 + TF-IDF
# 注册地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# Embedding 模式：local / api / hybrid（默认 hybrid）
EMBEDDING_MODE=hybrid

# 混合模式的边界阈值
HYBRID_LOW_THRESHOLD=0.5
HYBRID_HIGH_THRESHOLD=0.85

# ========== 系统安全（必填） ==========
# JWT 签名密钥（建议使用随机字符串）
SASES_SECRET_KEY=change-me-to-a-long-random-string

# 节点通信令牌（生产环境必须设置）
SASES_NODE_TOKEN=change-me-to-another-random-string

# ========== 节点配置（可选） ==========
SASES_NODE_ID=node-001
SASES_NODE_NAME=My SASES Node
SASES_PEERS=
SASES_ENABLE_MDNS=true
SASES_PORT=8001

# ========== 视觉/多模态模型（可选） ==========
VISION_MODEL_NAME=deepseek-v4-flash-vision-exp

# ========== 文件大小限制（字节） ==========
MAX_IMAGE_SIZE=5242880
MAX_AUDIO_SIZE=10485760
MAX_VIDEO_SIZE=26214400

# ========== 积分规则（可选） ==========
EXTERNAL_SEED_REWARD=5
MANUAL_POLLINATE_BASIC_REWARD=3
MANUAL_POLLINATE_EXPERT_REWARD=10
QUERY_DEDUCTION=2

# ========== 数据库路径（可选，默认在项目根目录） ==========
# DB_FILE=users.db
# KB_FILE=success_kb.json
# SEED_POOL_FILE=seed_tasks_external.jsonl
# MAIN_SEED_FILE=seed_tasks_new.jsonl

# ========== 已弃用（保留兼容） ==========
# SIMILARITY_THRESHOLD=0.30