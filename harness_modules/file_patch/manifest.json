{
  "id": "file_patch",
  "name": "精确修改文件",
  "description": "在已有文件中进行精确片段替换或锚点插入",
  "params": {
    "file_path": {
      "type": "string",
      "desc": "必填，要修改的文件路径"
    },
    "old_snippet": {
      "type": "string",
      "desc": "要替换的旧代码（选填）"
    },
    "new_snippet": {
      "type": "string",
      "desc": "新代码（选填）"
    },
    "anchor_pattern": {
      "type": "string",
      "desc": "锚点内容（选填）"
    },
    "position": {
      "type": "string",
      "desc": "before/after/replace_line"
    },
    "new_content": {
      "type": "string",
      "desc": "锚点插入的新内容（选填）"
    },
    "overwrite": {
      "type": "boolean",
      "desc": "是否覆盖整个文件（选填）"
    },
    "create_if_missing": {
      "type": "boolean",
      "desc": "如果不存在是否创建（选填）"
    }
  }
}