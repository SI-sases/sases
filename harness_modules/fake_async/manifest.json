  "version": "0.1.0",
  "entrypoint": "main.py",
  "task_mode": "async",
  "capabilities": [
    "fake_async"
  ],
  "permissions": [],
  "params": {
    "seconds": {
      "type": "int",
      "default": 10,
      "desc": "模拟耗时（秒）"
    }
  }
}
