{
  "id": "screen_click",
  "name": "屏幕点击",
  "description": "把鼠标移动到指定坐标并点击；默认 dry-run，只有 confirm=true 才真正执行。",
  "version": "1.0.0",
  "capabilities": ["computer_use", "input"],
  "permissions": ["screen", "input"],
  "entrypoint": "main.py",
  "node_type": "harness",
  "params": {
    "x": {"type": "integer", "desc": "必填，屏幕 X 坐标"},
    "y": {"type": "integer", "desc": "必填，屏幕 Y 坐标"},
    "button": {"type": "string", "desc": "left/right/middle"},
    "clicks": {"type": "integer", "desc": "1-3"},
    "interval": {"type": "number", "desc": "多次点击间隔秒"},
    "move_only": {"type": "boolean", "desc": "只移动不点击"},
    "confirm": {"type": "boolean", "desc": "必须为 true 才执行"}
  }
}
